# Postgres в docker compose
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db>
POSTGRES_TEST_DB=<test_db>

# Для локального запуска (uv run ...) против БД из docker compose;
# значения должны совпадать с POSTGRES_* выше
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<db>
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<test_db>

# Порты на хосте (docker compose)
# POSTGRES_HOST_PORT=5432
# APP_HOST_PORT=8000
